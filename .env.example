# =============================================================================
# Arcyn Find - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth Authentication
# Get these from: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Session signing (REQUIRED)
# Signs the arcyn_session cookie with HMAC-SHA256. Without it, sign-in fails and
# every request is treated as signed out -- there is no fallback secret on
# purpose, because a fallback is a shared secret anyone can forge sessions with.
# Generate:  openssl rand -base64 32
# Rotating this value invalidates every existing session.
# -----------------------------------------------------------------------------
SESSION_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Supabase Database
# Get these from: https://app.supabase.com/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: Keep this secret! Never expose in client-side code
# This key has full database access - only use server-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email Service (Resend)
# Get these from: https://resend.com/api-keys
# Optional - contact form will log to console if not configured
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Cron Job Authentication
# Generate a secure random string for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to authenticate Vercel cron job requests
CRON_SECRET=your-secure-random-string

# -----------------------------------------------------------------------------
# Google Verification (optional)
# For Google Search Console verification
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-site-verification-code

# -----------------------------------------------------------------------------
# Maintenance Mode (optional)
# Set to 'true' to enable maintenance mode
# -----------------------------------------------------------------------------
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Tool Discovery Sources (optional)
# These tokens improve the yield of scripts/discover-more-tools.js
# and scripts/fetch-from-all-sources.ts
# -----------------------------------------------------------------------------

# Product Hunt API v2 — enables GraphQL-based tool discovery
# Get your token from: https://api.producthunt.com/v2/oauth/applications
# If not set, falls back to RSS feed parsing
PRODUCTHUNT_API_TOKEN=

# GitHub API — raises rate limits from 10 req/min (unauthenticated) to 5000/hr
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Hugging Face API — enables model discovery from Hugging Face Hub
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# =============================================================================
# Security Best Practices
# =============================================================================
#
# 1. NEVER commit real secrets to version control
# 2. Use different values for development and production
# 3. Rotate secrets periodically (especially after team changes)
# 4. Use strong, randomly generated values for secrets
# 5. Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side
# 6. Review access logs regularly for suspicious activity
#
# Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Only use this prefix for truly public values (like client IDs, not secrets).
# =============================================================================

# Review round: shows the floating feedback button site-wide.
# Set to "true" only while a private feedback round is running.
NEXT_PUBLIC_FEEDBACK_MODE=false

# Web push (browser notifications)
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is embedded in the client bundle and is safe to expose.
# The private key signs push requests and must not be.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# RFC 8292 contact, so a push service can reach you about sender problems.
VAPID_SUBJECT=mailto:you@example.com
