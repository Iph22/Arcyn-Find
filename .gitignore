# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/database/.backfill-pricing-state.json

# Generated by the recommendation eval --collect run; regenerable, not a source of truth.
scripts/eval/collected-answers.json

# Batch job state (contains only ids, but is machine-local)
scripts/enrich/.state/

# Deleted from the repo in #21 because Windows Defender blocks it at the
# filter-driver level -- it cannot be read, renamed or deleted, so an existing
# checkout keeps an undeletable copy on disk forever. Ignoring it keeps
# `git status` clean and stops it being re-committed by a `git add -A`.
scripts/setup/fix-npm-path.ps1
